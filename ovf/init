#!/bin/sh
# /init — PID 1 inside the nettest mini-ISO initramfs.
#
# Mounts essential filesystems, loads VMware vmci/vsock modules when present,
# then starts netprobe which owns the rest of the boot (networking + probe protocol).
#
# IMPORTANT: PID 1 must never exit. If netprobe exits, kernel will panic with
# "Attempted to kill init". Keep init alive in a rescue path for diagnostics.

mount -t proc     proc     /proc
mount -t sysfs    sysfs    /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null \
    || mount -t tmpfs tmpfs /dev

# Minimal device nodes (fallback when devtmpfs is unavailable)
[ -c /dev/null ]  || mknod -m 666 /dev/null  c 1 3
[ -c /dev/ttyS0 ] || mknod -m 660 /dev/ttyS0 c 4 64

mkdir -p /dev/pts
mount -t devpts devpts /dev/pts 2>/dev/null || true

# Load VMware vmci/vsock modules so vsock poll_method is available.
# Non-fatal — serial mode works without them.
for mod in vmw_vmci vsock vmw_vsock_vmci_transport vmxnet3; do
    ko="/lib/modules/${mod}.ko"
    [ -f "$ko" ] && insmod "$ko" 2>/dev/null || true
done

PROBE="/usr/local/bin/netprobe"

if [ ! -x "$PROBE" ]; then
    echo "[init] FATAL: $PROBE not found/executable" >/dev/console
    if [ -x /bin/sh ]; then
        exec /bin/sh
    fi
    while true; do sleep 3600; done
fi

"$PROBE"
rc=$?
echo "[init] netprobe exited rc=$rc; entering rescue mode" >/dev/console

if [ -x /bin/sh ]; then
    exec /bin/sh
fi

while true; do sleep 3600; done
